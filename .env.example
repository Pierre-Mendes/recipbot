# Application
APP_NAME="RecipBot"
APP_ENV=local
APP_KEY=base64:changeme
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=recipbot
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis (Cache + Queue)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Cache
CACHE_DRIVER=redis
CACHE_PREFIX=recipbot_cache_

# Queue
QUEUE_CONNECTION=redis
QUEUE_DRIVER=redis

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Mail (for future use)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@recipbot.local
MAIL_FROM_NAME="${APP_NAME}"

# Authentication
JWT_SECRET=base64:changeme
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=3600
# php-open-source-saver/jwt-auth reads JWT_TTL (minutes), not JWT_EXPIRES_IN (seconds) above.
# Both describe the same 1h expiration from OWASP_CHECKLIST.md; JWT_TTL is the one actually consumed by config/jwt.php.
JWT_TTL=60

# API Limits (Security)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD=60

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Scraper Configuration (OWASP A10 - SSRF Protection)
SCRAPER_TIMEOUT=10
SCRAPER_MAX_SIZE=5242880  # 5MB
SCRAPER_WHITELIST_DOMAINS=tudogostoso.com.br,cybercook.com.br,receitas.globo.com

# OCR Services (MVP = free/local only)
# Optional: Gemini Vision (Phase 2+)
GEMINI_API_KEY=
GEMINI_ENABLED=false

# Optional: Claude Vision (Phase 2+)
CLAUDE_API_KEY=
CLAUDE_ENABLED=false

# Embedding Service (Phase 2+)
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=

# Frontend
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=RecipBot
VITE_APP_ENV=development
