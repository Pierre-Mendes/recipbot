NODE_ENV=development
PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recipbot
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recipbot?schema=public

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# "webhook" (default, requires TELEGRAM_WEBHOOK_SECRET + a public HTTPS URL
# registered with Telegram) or "polling" for local dev without a public URL.
TELEGRAM_BOT_MODE=webhook
# Required in webhook mode: sent back by Telegram in every webhook request
# as X-Telegram-Bot-Api-Secret-Token and checked against this value.
TELEGRAM_WEBHOOK_SECRET=change_me_to_a_random_secret
GEMINI_API_KEY=your_gemini_api_key_here
# Optional, defaults to gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
# Optional, defaults to text-embedding-004 (768 dims, matches database-schema.sql)
GEMINI_EMBEDDING_MODEL=text-embedding-004
