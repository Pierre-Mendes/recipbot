{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".*\\.integration-spec\\.ts$",
  "setupFiles": ["reflect-metadata"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
  "testEnvironment": "node",
  "testTimeout": 30000
}
