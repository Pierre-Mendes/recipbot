# =============================================================================
# RecipBot — PRODUCTION environment template
# =============================================================================
# Copy to `.env` on the production host and replace every "CHANGE_ME" value.
# The real `.env` is git-ignored and NEVER committed. Only environment-varying
# values live here (URLs, hosts, secrets); everything read in code goes through
# config/*.php, so run `php artisan config:cache` after editing.
# =============================================================================

# Application
APP_NAME="RecipBot"
APP_ENV=production
# Generate once with: php artisan key:generate --show
APP_KEY=CHANGE_ME
# Debug MUST be false in production so stack traces / SQL never reach clients.
APP_DEBUG=false
# Public URL of the API (backend).
APP_URL=https://api.recipbot.com
# Public URL of the Vue SPA — used for password-reset links and CORS defaults.
FRONTEND_URL=https://app.recipbot.com

# Database (managed PostgreSQL — RDS / Supabase)
DB_CONNECTION=pgsql
DB_HOST=CHANGE_ME.rds.amazonaws.com
DB_PORT=5432
DB_DATABASE=recipbot
DB_USERNAME=recipbot
DB_PASSWORD=CHANGE_ME

# Redis (managed cache + queue)
REDIS_CLIENT=phpredis
REDIS_HOST=CHANGE_ME
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Cache / Queue
CACHE_STORE=redis
CACHE_PREFIX=recipbot_cache_
QUEUE_CONNECTION=redis

# Session / Cookies (Security) — HTTPS in production
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# TLS-only cookie: required in production so the session cookie never travels over HTTP.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# CORS: the exact production origin(s) allowed to call the API. Never "*".
CORS_ALLOWED_ORIGINS=https://app.recipbot.com

# Mail (transactional — password reset, etc.)
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@recipbot.com
MAIL_FROM_NAME="${APP_NAME}"

# Authentication (JWT) — rotate the secret and keep it out of source control.
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_TTL=60

# API rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD=60

# Logging — warning (not debug) in production to avoid noisy / sensitive logs.
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Scraper (OWASP A10 — SSRF protection)
SCRAPER_TIMEOUT=10
SCRAPER_MAX_SIZE=5242880
SCRAPER_WHITELIST_DOMAINS=tudogostoso.com.br,receitas.globo.com,gshow.globo.com

# OCR / AI providers (optional — keep disabled unless a key is set)
GEMINI_API_KEY=
GEMINI_ENABLED=false
CLAUDE_API_KEY=
CLAUDE_ENABLED=false
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=

# -----------------------------------------------------------------------------
# Frontend (Vite) — NOTE: these are baked into the bundle at BUILD time, so they
# are set in the frontend build environment (CI), not read from this file at
# runtime. VITE_ values are public (shipped to the browser) — never put secrets
# here. For one build deployed to several environments, prefer a runtime config
# (e.g. a fetched /config.json) over rebuilding per environment.
# -----------------------------------------------------------------------------
VITE_API_URL=https://api.recipbot.com/api
VITE_APP_NAME=RecipBot
VITE_APP_ENV=production
