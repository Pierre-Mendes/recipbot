FROM php:8.4-cli-alpine

# Install system dependencies
RUN apk add --no-cache \
    curl \
    git \
    wget \
    bash \
    build-base \
    libpq-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    libwebp-dev \
    freetype-dev \
    icu-dev \
    icu-libs \
    libzip-dev

# Install PHP extensions
# Note: pdo, ctype, json, mbstring, openssl, posix, tokenizer, xml ship built-in
# on the php:8.4-cli-alpine base image; only these need building.
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp
RUN docker-php-ext-install \
    pdo_pgsql \
    bcmath \
    pcntl \
    gd \
    intl \
    zip

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Install pcov for test coverage (dev-only, negligible prod overhead)
# autoconf is re-added here since docker-php-ext-install purges it after building extensions
RUN apk add --no-cache --virtual .pcov-build-deps autoconf \
    && pecl install pcov \
    && docker-php-ext-enable pcov \
    && apk del .pcov-build-deps

# Set working directory
WORKDIR /app

# Create non-root user
RUN addgroup -g 1000 laravel && \
    adduser -D -u 1000 -G laravel laravel

# Copy application files
COPY . .

# Install PHP dependencies
RUN composer install --no-interaction --prefer-dist --optimize-autoloader

# Make the entrypoint executable (runs migrations before the app boots)
RUN chmod +x /app/docker/entrypoint.sh

# Set permissions
RUN chown -R laravel:laravel /app

# Switch to non-root user
USER laravel

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
